{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3055",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen --typecheck disable",
    "build": "node ./scripts/build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --project convex --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.20",
    "@workspace/contracts": "workspace:^",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "convex": "^1.48.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3"
  }
