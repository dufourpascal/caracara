{
  "name": "caracara-score",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "caracara": "node scripts/run-caracara.mjs",
    "caracara:build": "pnpm --filter @workspace/contracts build && pnpm --filter caracara build",
    "dev": "turbo run dev convex:dev --filter=web --parallel",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@workspace/typescript-config": "workspace:*",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
